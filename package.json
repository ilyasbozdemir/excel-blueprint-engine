{
  "name": "excel-sablon-klonlama",
  "version": "1.0.1",
  "description": "Premium Excel Template Cloner",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev-vite": "vite --port 5173 --strictPort",
    "dev-electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently \"pnpm dev-vite\" \"pnpm dev-electron\"",
    "build": "pnpm vite build && pnpm electron-builder",
    "start": "pnpm electron ."
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "luxon": "^3.5.0",
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "vite": "^5.0.0",
    "electron-builder": "^24.0.0",
    "concurrently": "^8.0.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.excel-blueprint-engine",
    "productName": "Excel Blueprint Master",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}